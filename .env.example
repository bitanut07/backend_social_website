APP_NAME=Artly
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_URL=http://localhost
APP_HOST=127.0.0.1
APP_PORT=3000
CORS_ALLOWED_ORIGIN=http://localhost:5173
HTTP_ASSISTANT_REQUEST_TIMEOUT=110s
HTTP_WRITE_TIMEOUT=115s

JWT_SECRET=

AI_PROVIDER=local
AI_TEXT_MODEL=gpt-5.6-luna

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model nội bộ qua SSH tunnel. Để trống một trong bốn biến bắt buộc đầu tiên
# nếu chỉ muốn dùng parser local.
MODEL_LLM_HOST=
MODEL_LLM_SSH_PORT=22
MODEL_LLM_SSH_USER=
MODEL_LLM_SSH_KEY_PATH=
# Dùng secret nhiều dòng này thay cho file key khi chạy serverless.
MODEL_LLM_SSH_PRIVATE_KEY=
MODEL_LLM_HOST_KEY_SHA256=
MODEL_LLM_REMOTE_ADDRESS=127.0.0.1:11434
MODEL_LLM_MODEL=qwen3:1.7b
MODEL_LLM_CONNECT_TIMEOUT_SECONDS=8
MODEL_LLM_REQUEST_TIMEOUT_SECONDS=90

DB_CONNECTION=postgres
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require
DB_SCHEMA=public
DB_TIMEZONE=UTC

SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
ALLOW_DEMO_USER_HEADER=true
ARTLY_DEMO_ASSET_DIR=../frontend/public/demo-art
ARTLY_DEMO_PASSWORD=artly-demo

# Direct PostgreSQL (ưu tiên cho migration khi có IPv6)
SUPABASE_DB_HOST=db.YOUR_PROJECT_REF.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# Shared pooler (Session: 5432, Transaction: 6543)
SUPABASE_POOLER_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_SESSION_POOLER_PORT=5432
SUPABASE_TRANSACTION_POOLER_PORT=6543
SUPABASE_POOLER_USER=postgres.YOUR_PROJECT_REF

# Có thể ghi đè; Vercel mặc định dùng 0/5/60/300 để tránh cạn pool.
DB_MAX_IDLE_CONNS=
DB_MAX_OPEN_CONNS=
DB_CONN_MAX_IDLETIME=
DB_CONN_MAX_LIFETIME=

GRPC_HOST=
GRPC_PORT=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
